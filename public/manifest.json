{
  "name": "JournalScope - Sistema de Consulta de Journals Acadêmicos",
  "short_name": "JournalScope",
  "description": "Ferramenta completa para consulta e análise de classificações ABDC, ABS e Wiley de journals acadêmicos. Base de dados unificada com mais de 4.000 periódicos científicos.",
  "version": "1.0.0",
  "manifest_version": 2,
  
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  
  "theme_color": "#2563eb",
  "background_color": "#ffffff",
  
  "categories": ["education", "productivity", "utilities"],
  "lang": "pt-BR",
  
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "16x16 32x32 48x48",
      "type": "image/x-icon",
      "purpose": "any"
    }
  ],
  

  
  "related_applications": [],
  "prefer_related_applications": false,
  
  "dir": "ltr",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"],
        "text/csv": [".csv"]
      }
    }
  ],
  
  "protocol_handlers": [
    {
      "protocol": "web+journalscope",
      "url": "/?query=%s"
    }
  ],
  
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "journals",
          "accept": ["text/csv", ".csv", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", ".xlsx"]
        }
      ]
    }
  },
  
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  
  "handle_links": "preferred",
  
  "capture_links": "existing-client-navigate",
  
  "scope_extensions": [
    {
      "origin": "https://journalscope.app"
    }
  ],
  
  "id": "journalscope-app",
  
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  
  "features": [
    "Cross Platform",
    "Offline Support", 
    "Fast Loading",
    "Responsive Design",
    "Export Functionality",
    "Advanced Search",
    "Data Visualization",
    "Multiple Languages"
  ],
  
  "gcm_sender_id": "103953800507",
  
  "permissions": [
    "clipboard-write",
    "clipboard-read"
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "data/*.xlsx", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "custom": {
    "journalscope": {
      "supportedDatabases": ["ABDC", "ABS", "Wiley"],
      "totalJournals": 4460,
      "lastUpdated": "2024-01-15",
      "exportFormats": ["CSV", "JSON", "Excel"],
      "languages": ["pt-BR", "en-US"],
      "features": {
        "darkMode": true,
        "accessibility": true,
        "analytics": false,
        "offline": true
      },
      "minimumRequirements": {
        "chrome": "88",
        "firefox": "85",
        "safari": "14",
        "edge": "88"
      },
      "supportContact": {
        "email": "support@journalscope.app",
        "website": "https://journalscope.app/support"
      }
    }
  },
  
  "note": "JournalScope - A ferramenta definitiva para pesquisadores acadêmicos consultarem classificações de journals científicos. Desenvolvida para ser rápida, confiável e fácil de usar."
}
