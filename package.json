{
  "name": "journalscope",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Consulta de Journals Acadêmicos",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-data && vite build",
    "build:vercel": "npm run generate-data && vite build",
    "preview": "vite preview",
    "generate-data": "node scripts/generateEmbeddedData.js",
    "build-optimized": "npm run generate-data && npm run build",
    "analyze-performance": "npm run build && npx vite-bundle-analyzer dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.6.0",
    "sheetjs-style": "^0.15.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "terser": "^5.43.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
