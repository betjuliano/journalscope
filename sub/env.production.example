# Configuração de Produção - Sistema SUB
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL="file:./prisma/db/custom.db"

# CORS Origins (ajustar conforme domínios de produção)
ALLOWED_ORIGINS="http://localhost:8080,https://periodicos.iaprojetos.com.br,https://periodicos.iatranscreve.com.br"

# Security
SESSION_SECRET="your-super-secret-session-key-change-this-in-production"

# Logs
LOG_LEVEL=info
LOG_FILE=/app/logs/sub-system.log

# Health Check
HEALTH_CHECK_ENABLED=true
